# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_INITIAL_PASSWORD: Initial server-side password for the /admin portal (username: shabbir2020).
# Configure via Secrets / Environment Variables before sharing or deploying.
ADMIN_INITIAL_PASSWORD=

# ADMIN_SESSION_SECRET: Optional HMAC signing secret for server-issued admin and student session tokens.
ADMIN_SESSION_SECRET=
